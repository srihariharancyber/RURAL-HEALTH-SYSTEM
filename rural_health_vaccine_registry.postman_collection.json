{
  "info": {
    "_postman_id": "f82b7194-e3c1-4d92-bb8a-2a4c9b910321",
    "name": "Rural Health Clinic Vaccine & Registry Database API",
    "description": "Complete REST API collection for interacting with MySQL database tables: Patients, Vaccines, Cold-Chain Refrigeration Equipment, Temperature Logs, Immunization Events, Clinical Alerts, and Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "admin",
        "type": "string"
      },
      {
        "key": "password",
        "value": "admin123",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Patients Database",
      "item": [
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients"]
            },
            "description": "Retrieve all registered patient records from the database."
          }
        },
        {
          "name": "Search Patients by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients?search=Aarav",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients"],
              "query": [
                {
                  "key": "search",
                  "value": "Aarav"
                }
              ]
            },
            "description": "Search patients by name or phone keyword."
          }
        },
        {
          "name": "Filter Patients by Village",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients?village=Rampur",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients"],
              "query": [
                {
                  "key": "village",
                  "value": "Rampur"
                }
              ]
            },
            "description": "Filter patients by rural village location."
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients", "1"]
            },
            "description": "Fetch a single patient record by primary key ID."
          }
        },
        {
          "name": "Create New Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Rohan Mehta\",\n  \"dateOfBirth\": \"2026-02-15\",\n  \"gender\": \"Male\",\n  \"phone\": \"+91 98765 11223\",\n  \"address\": \"Gali No. 4, Post Office Road\",\n  \"village\": \"Rampur\",\n  \"guardianName\": \"Kavita Mehta (Mother)\",\n  \"guardianPhone\": \"+91 98765 11223\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/patients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "patients"]
            },
            "description": "Insert a new infant or child patient into the database."
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Aarav Kumar\",\n  \"dateOfBirth\": \"2026-07-20\",\n  \"gender\": \"Male\",\n  \"phone\": \"+91 98450 12345\",\n  \"address\": \"House 42, North Lane, Updated\",\n  \"village\": \"Rampur\",\n  \"guardianName\": \"Sunita Kumar (Mother)\",\n  \"guardianPhone\": \"+91 98450 12345\"\n}"
